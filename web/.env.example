# Copy this file to .env.local to run the site against the fleet's database on
# your own computer. On Vercel the Supabase integration sets these for you.
#
# Both values are public: they identify the project, they do not unlock it.
# Never put a secret key in this file or anywhere in this repository.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
